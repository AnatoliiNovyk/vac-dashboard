////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: ЭкспортДляVacationDashboard
// Назначение: Экспорт данных сотрудников для Vacation Dashboard
// Платформа: 1С:Предприятие 8.3
// Конфигурация: Зарплата и управление персоналом, редакция 3.0
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    // Установка значений по умолчанию
    Объект.ДатаВыгрузки = ТекущаяДата();
    Объект.КодировкаФайла = "UTF-8";
    Объект.РазделительПолей = ";";
    
    // Заполнение списка организаций
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Организации.Ссылка КАК Организация,
        |   Организации.Наименование КАК Наименование
        |ИЗ
        |   Справочник.Организации КАК Организации
        |ГДЕ
        |   НЕ Организации.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО
        |   Наименование";
    
    РезультатЗапроса = Запрос.Выполнить();
    Если НЕ РезультатЗапроса.Пустой() Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Если Выборка.Следующий() Тогда
            Объект.Организация = Выборка.Организация;
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьЭкспорт(Команда)
    
    // Проверка заполнения
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        ПоказатьПредупреждение(, "Не выбрана организация!");
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(Объект.ДатаВыгрузки) Тогда
        ПоказатьПредупреждение(, "Не указана дата выгрузки!");
        Возврат;
    КонецЕсли;
    
    // Выбор файла для сохранения
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Заголовок = "Сохранить файл экспорта";
    Диалог.Фильтр = "CSV файлы (*.csv)|*.csv";
    Диалог.Расширение = "csv";
    Диалог.ПолноеИмяФайла = "employees_export_" + Формат(Объект.ДатаВыгрузки, "ДФ=yyyy-MM-dd") + ".csv";
    
    Если Диалог.Выбрать() Тогда
        ПутьФайла = Диалог.ПолноеИмяФайла;
        
        // Получаем данные на сервере
        ТекстCSV = ПолучитьДанныеДляЭкспортаНаСервере();
        
        Если ТекстCSV <> "" Тогда
            // Записываем файл на клиенте
            ЗаписатьФайлНаКлиенте(ПутьФайла, ТекстCSV);
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьФайлНаКлиенте(ПутьФайла, ТекстCSV)
    
    Попытка
        // Кодировка UTF-8, перезаписывать файл (Ложь)
        Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8, , Ложь);
        Запись.Записать(ТекстCSV);
        Запись.Закрыть();
        
        ДобавитьВЛогНаСервере("Экспорт успешно завершен!");
        ДобавитьВЛогНаСервере("Файл сохранен: " + ПутьФайла);
        ПоказатьПредупреждение(, "Экспорт завершен успешно!" + Символы.ПС + "Файл: " + ПутьФайла);
    Исключение
        ДобавитьВЛогНаСервере("ОШИБКА записи файла: " + ОписаниеОшибки());
        ПоказатьПредупреждение(, "Ошибка записи файла: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляЭкспортаНаСервере()
    
    ДобавитьВЛог("Начало экспорта для организации: " + Объект.Организация);
    
    Попытка
        ДанныеСотрудников = ПолучитьДанныеСотрудников(Объект.Организация, Объект.ДатаВыгрузки);
        
        Если ДанныеСотрудников.Количество() = 0 Тогда
            ДобавитьВЛог("ВНИМАНИЕ: Не найдено сотрудников для экспорта!");
            Возврат "";
        КонецЕсли;
        
        ДобавитьВЛог("Найдено сотрудников: " + ДанныеСотрудников.Количество());
        
        // Формируем CSV
        ТекстCSV = СформироватьCSV(ДанныеСотрудников);
        
        Возврат ТекстCSV;
        
    Исключение
        ДобавитьВЛог("ОШИБКА: " + ОписаниеОшибки());
        Возврат "";
    КонецПопытки;
    
КонецФункции

&НаСервере
Процедура ДобавитьВЛогНаСервере(Сообщение) Экспорт
    ДобавитьВЛог(Сообщение);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДанныеСотрудников(Организация, ДатаВыгрузки)
    
    Результат = Новый Массив;
    
    // Основной запрос для получения действующих сотрудников
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("ДатаВыгрузки", ДатаВыгрузки);
    
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо КАК ФизическоеЛицо,
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо.КодПоДРФО КАК ИНН,
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо.Фамилия КАК Фамилия,
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо.Имя КАК Имя,
        |   КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ФизическоеЛицо.Отчество КАК Отчество,
        |   КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Подразделение,
        |   КадроваяИсторияСотрудниковСрезПоследних.Подразделение.Наименование КАК ПодразделениеНаименование,
        |   КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
        |   КадроваяИсторияСотрудниковСрезПоследних.Должность.Наименование КАК ДолжностьНаименование
        |ИЗ
        |   РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&ДатаВыгрузки, Организация = &Организация) КАК КадроваяИсторияСотрудниковСрезПоследних
        |ГДЕ
        |   КадроваяИсторияСотрудниковСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
        |   И НЕ КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ПометкаУдаления";
    
    РезультатЗапроса = Запрос.Выполнить();
    // Выгружаем в ТЗ для получения массива ссылок
    ТЗСотрудников = РезультатЗапроса.Выгрузить();
    МассивСотрудников = ТЗСотрудников.ВыгрузитьКолонку("Сотрудник");
    
    // Получение данных об остатках отпусков (передаем массив сотрудников для фильтрации)
    ДанныеОстатковОтпусков = ПолучитьОстаткиОтпусков(МассивСотрудников, ДатаВыгрузки);
    
    // Получение руководителей для всех сотрудников из документов
    РуководителиСотрудников = ПолучитьРуководителейСотрудников(Организация, ДатаВыгрузки);
    
    Для Каждого Выборка Из ТЗСотрудников Цикл
        
        ДанныеСотрудника = Новый Структура;
        
        // Основные данные
        ДанныеСотрудника.Вставить("ИНН", СокрЛП(Выборка.ИНН));
        ДанныеСотрудника.Вставить("Фамилия", СокрЛП(Выборка.Фамилия));
        ДанныеСотрудника.Вставить("Имя", СокрЛП(Выборка.Имя));
        ДанныеСотрудника.Вставить("Отчество", СокрЛП(Выборка.Отчество));
        ДанныеСотрудника.Вставить("Подразделение", СокрЛП(Выборка.ПодразделениеНаименование));
        ДанныеСотрудника.Вставить("Должность", СокрЛП(Выборка.ДолжностьНаименование));
        
        // Руководитель
        ИННРуководителя = "";
        НайденныйРуководитель = РуководителиСотрудников.Получить(Выборка.Сотрудник);
        
        Если НайденныйРуководитель <> Неопределено Тогда
            ИННРуководителя = НайденныйРуководитель;
        КонецЕсли;
        
        // Защита от самоподчинения
        Если ИННРуководителя = СокрЛП(Выборка.ИНН) Тогда
            ИННРуководителя = "";
        КонецЕсли;
            
        ДанныеСотрудника.Вставить("ИННРуководителя", ИННРуководителя);
        
        // Остатки отпусков
        Начислено = 24; // Значение по умолчанию
        Осталось = 24;  // Значение по умолчанию
        
        ДанныеОстатка = ДанныеОстатковОтпусков.Получить(Выборка.Сотрудник);
        Если ДанныеОстатка <> Неопределено Тогда
            Начислено = ДанныеОстатка.Начислено;
            Осталось = ДанныеОстатка.Остаток;
        КонецЕсли;

        ДанныеСотрудника.Вставить("НачисленоДней", Начислено);
        ДанныеСотрудника.Вставить("ОсталосьДней", Осталось);
        
        // Определение ролей
        ЭтоHR = ОпределитьЭтоHR(Выборка.ПодразделениеНаименование, Выборка.ДолжностьНаименование);
        ЭтоРуководительHR = ЭтоHR И ОпределитьЭтоРуководитель(Выборка.ДолжностьНаименование);
        ЭтоРуководитель = ОпределитьЭтоРуководитель(Выборка.ДолжностьНаименование);
        
        ДанныеСотрудника.Вставить("ЭтоHR", ?(ЭтоHR, "true", "false"));
        ДанныеСотрудника.Вставить("ЭтоРуководительHR", ?(ЭтоРуководительHR, "true", "false"));
        ДанныеСотрудника.Вставить("ЭтоРуководитель", ?(ЭтоРуководитель, "true", "false"));
        
        Результат.Добавить(ДанныеСотрудника);
        
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ПолучитьОстаткиОтпусков(МассивСотрудников, ДатаВыгрузки)
    
    Результат = Новый Соответствие;
    
    Если МассивСотрудников.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    
    // Стандартное количество дней отпуска
    СтандартныйОтпуск = 24;
    
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
    Запрос.УстановитьПараметр("ДатаВыгрузки", ДатаВыгрузки);
    
    // Попытка получить данные из регистра "ФактическиеОтпуска"
    // Фильтруем по списку сотрудников, который мы уже отобрали (это безопаснее, чем фильтровать по Организации в регистре)
    
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   ФактическиеОтпуска.Сотрудник КАК Сотрудник,
        |   СУММА(ЕСТЬNULL(ФактическиеОтпуска.Количество, 0)) КАК ИспользованоДней
        |ИЗ
        |   РегистрНакопления.ФактическиеОтпуска КАК ФактическиеОтпуска
        |ГДЕ
        |   ФактическиеОтпуска.Период <= &ДатаВыгрузки
        |   И ФактическиеОтпуска.Сотрудник В (&МассивСотрудников)
        |
        |СГРУППИРОВАТЬ ПО
        |   ФактическиеОтпуска.Сотрудник";
    
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();
        
        Пока Выборка.Следующий() Цикл
            
            Использовано = Выборка.ИспользованоДней;
            Остаток = СтандартныйОтпуск - Использовано;
            
            // Структура для хранения данных
            Данные = Новый Структура;
            Данные.Вставить("Начислено", СтандартныйОтпуск);
            Данные.Вставить("Использовано", Использовано);
            Данные.Вставить("Остаток", Остаток);
            
            Результат.Вставить(Выборка.Сотрудник, Данные);
            
        КонецЦикла;
        
        ДобавитьВЛог("Успешно получены данные об использовании отпусков.");
        
    Исключение
        ДобавитьВЛог("ПРЕДУПРЕЖДЕНИЕ: Не удалось получить данные из регистра 'ФактическиеОтпуска'. Используются значения по умолчанию (24 дня). Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ПолучитьРуководителейСотрудников(Организация, ДатаВыгрузки)
    
    Результат = Новый Соответствие;
    
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("ДатаВыгрузки", ДатаВыгрузки);
    
    // Выбираем руководителя из кадровых документов (Прием и Перевод)
    // Берем последнего установленного руководителя на дату выгрузки
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Прием.Сотрудник КАК Сотрудник,
        |   Прием.ДатаПриема КАК Период,
        |   Прием.Руководитель КАК Руководитель
        |ПОМЕСТИТЬ ВТ_КадровыеДокументы
        |ИЗ
        |   Документ.ПриемНаРаботу КАК Прием
        |ГДЕ
        |   Прием.Проведен
        |   И Прием.Организация = &Организация
        |   И Прием.ДатаПриема <= &ДатаВыгрузки
        |   И ЕСТЬNULL(Прием.Руководитель.КодПоДРФО, """") <> """"
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |   Перевод.Сотрудник,
        |   Перевод.ДатаНачала,
        |   Перевод.Руководитель
        |ИЗ
        |   Документ.КадровыйПеревод КАК Перевод
        |ГДЕ
        |   Перевод.Проведен
        |   И Перевод.Организация = &Организация
        |   И Перевод.ДатаНачала <= &ДатаВыгрузки
        |   И ЕСТЬNULL(Перевод.Руководитель.КодПоДРФО, """") <> """"
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   ВТ_КадровыеДокументы.Сотрудник КАК Сотрудник,
        |   МАКСИМУМ(ВТ_КадровыеДокументы.Период) КАК Период
        |ПОМЕСТИТЬ ВТ_ПоследниеДаты
        |ИЗ
        |   ВТ_КадровыеДокументы КАК ВТ_КадровыеДокументы
        |
        |СГРУППИРОВАТЬ ПО
        |   ВТ_КадровыеДокументы.Сотрудник
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   КадровыеДокументы.Сотрудник КАК Сотрудник,
        |   КадровыеДокументы.Руководитель.КодПоДРФО КАК ИННРуководителя
        |ИЗ
        |   ВТ_ПоследниеДаты КАК ПоследниеДаты
        |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КадровыеДокументы КАК КадровыеДокументы
        |       ПО ПоследниеДаты.Сотрудник = КадровыеДокументы.Сотрудник
        |           И ПоследниеДаты.Период = КадровыеДокументы.Период";
    
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();
        
        Пока Выборка.Следующий() Цикл
            Результат.Вставить(Выборка.Сотрудник, СокрЛП(Выборка.ИННРуководителя));
        КонецЦикла;
        
    Исключение
        ДобавитьВЛог("Предупреждение: не удалось получить руководителей из документов - " + ОписаниеОшибки());
    КонецПопытки;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ОпределитьЭтоHR(ПодразделениеНаименование, ДолжностьНаименование)
    
    // Проверка по названию подразделения
    ПодразделениеВерхний = ВРег(ПодразделениеНаименование);
    Если СтрНайти(ПодразделениеВерхний, "КАДР") > 0 
        ИЛИ СтрНайти(ПодразделениеВерхний, "HR") > 0
        ИЛИ СтрНайти(ПодразделениеВерхний, "ПЕРСОНАЛ") > 0 Тогда
        Возврат Истина;
    КонецЕсли;
    
    // Проверка по должности
    ДолжностьВерхний = ВРег(ДолжностьНаименование);
    Если СтрНайти(ДолжностьВерхний, "КАДР") > 0 
        ИЛИ СтрНайти(ДолжностьВерхний, "HR") > 0 Тогда
        Возврат Истина;
    КонецЕсли;
    
    Возврат Ложь;
    
КонецФункции

&НаСервере
Функция ОпределитьЭтоРуководитель(ДолжностьНаименование)
    
    ДолжностьВерхний = ВРег(ДолжностьНаименование);
    
    // Список ключевых слов для определения руководящей должности
    КлючевыеСлова = Новый Массив;
    КлючевыеСлова.Добавить("ДИРЕКТОР");
    КлючевыеСлова.Добавить("НАЧАЛЬНИК");
    КлючевыеСлова.Добавить("РУКОВОДИТЕЛЬ");
    КлючевыеСлова.Добавить("МЕНЕДЖЕР");
    КлючевыеСлова.Добавить("ЗАВЕДУЮЩ");
    КлючевыеСлова.Добавить("ЗАМЕСТИТЕЛЬ");
    КлючевыеСлова.Добавить("MANAGER");
    КлючевыеСлова.Добавить("HEAD");
    КлючевыеСлова.Добавить("LEAD");
    КлючевыеСлова.Добавить("CHIEF");
    
    Для Каждого Слово Из КлючевыеСлова Цикл
        Если СтрНайти(ДолжностьВерхний, Слово) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Ложь;
    
КонецФункции

&НаСервере
Функция СформироватьCSV(ДанныеСотрудников)
    
    // Используем запятую как разделитель, согласно формату test_import.csv
    Разделитель = ",";
    
    // Заголовки в соответствии с форматом импорта Vacation Dashboard
    // ВАЖНО: Порядок полей должен совпадать с ожиданиями импорта (test_import.csv), новые поля добавляем в конец
    Заголовки = "ІПН" + Разделитель
        + "Прізвище" + Разделитель
        + "Ім'я" + Разделитель
        + "По_батькові" + Разделитель
        + "Підрозділ" + Разделитель
        + "Посада" + Разделитель
        + "Нараховано_днів" + Разделитель
        + "Залишок_днів" + Разделитель
        + "Менеджер_ІПН" + Разделитель
        + "is_hr" + Разделитель
        + "is_hr_head" + Разделитель
        + "is_manager";
    
    Строки = Новый Массив;
    Строки.Добавить(Заголовки);
    
    Для Каждого Сотрудник Из ДанныеСотрудников Цикл
        
        СтрокаДанных = ЭкранироватьЗначениеCSV(Сотрудник.ИНН) + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.Фамилия) + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.Имя) + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.Отчество) + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.Подразделение) + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.Должность) + Разделитель
            + Формат(Сотрудник.НачисленоДней, "ЧГ=0") + Разделитель
            + Формат(Сотрудник.ОсталосьДней, "ЧГ=0") + Разделитель
            + ЭкранироватьЗначениеCSV(Сотрудник.ИННРуководителя) + Разделитель
            + Сотрудник.ЭтоHR + Разделитель
            + Сотрудник.ЭтоРуководительHR + Разделитель
            + Сотрудник.ЭтоРуководитель;
        
        Строки.Добавить(СтрокаДанных);
        
    КонецЦикла;
    
    Возврат СтрСоединить(Строки, Символы.ПС);
    
КонецФункции

&НаСервере
Функция ЭкранироватьЗначениеCSV(Значение)
    
    СтроковоеЗначение = СокрЛП(Строка(Значение));
    
    // Если содержит спецсимволы (запятую, точку с запятой, кавычки, перенос строки) - оборачиваем в кавычки
    Если СтрНайти(СтроковоеЗначение, ",") > 0
        ИЛИ СтрНайти(СтроковоеЗначение, ";") > 0 
        ИЛИ СтрНайти(СтроковоеЗначение, """") > 0
        ИЛИ СтрНайти(СтроковоеЗначение, Символы.ПС) > 0
        ИЛИ СтрНайти(СтроковоеЗначение, Символы.ВК) > 0 Тогда
        
        СтроковоеЗначение = СтрЗаменить(СтроковоеЗначение, """", """""");
        СтроковоеЗначение = """" + СтроковоеЗначение + """";
        
    КонецЕсли;
    
    Возврат СтроковоеЗначение;
    
КонецФункции

&НаСервере
Процедура ДобавитьВЛог(Сообщение)
    
    ВремяСообщения = Формат(ТекущаяДата(), "ДФ=HH:mm:ss");
    Объект.Лог = Объект.Лог + ВремяСообщения + " - " + Сообщение + Символы.ПС;
    
КонецПроцедуры

