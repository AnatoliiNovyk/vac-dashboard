<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vacation Dashboard - ╨Т╤Е╤Ц╨┤</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="fas fa-calendar-alt"></i>
                    Vacation Dashboard
                </h1>
                <button type="button" id="logout-btn" class="btn btn--secondary btn--sm header-logout-btn"
                    aria-label="╨Т╨╕╨╣╤В╨╕ ╤Ц╨╖ ╨┐╤А╨╛╤Д╤Ц╨╗╤О">
                    <i class="fas fa-right-from-bracket" aria-hidden="true"></i>
                    <span class="header-logout-btn__label">╨Т╨╕╨╣╤В╨╕</span>
                </button>
            </div>
        </div>
    </header>


    <!-- Vacation Manager Modal -->
    <div id="vacation-manager-modal" class="modal hidden" role="dialog" aria-modal="true"
        aria-labelledby="vacation-manager-title">
        <div class="modal-content vacation-manager">
            <div class="modal-header">
                <h3 id="vacation-manager-title">╨Я╨╡╤А╤Ц╨╛╨┤╨╕ ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨╛╨║</h3>
                <button type="button" id="vacation-manager-close" class="modal-close" aria-label="╨Ч╨░╨║╤А╨╕╤В╨╕">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="vacation-manager-form">
                <div class="modal-body">
                    <div class="vacation-manager__employee">
                        <label for="vacation-manager-employee-select" class="form-label">╨б╨┐╤Ц╨▓╤А╨╛╨▒╤Ц╤В╨╜╨╕╨║</label>
                        <select id="vacation-manager-employee-select" class="form-control hidden"></select>
                        <div id="vacation-manager-employee-name" class="vacation-manager__employee-name">тАФ</div>
                    </div>
                    <div class="vacation-manager__section">
                        <div class="vacation-manager__section-header">
                            <h4>╨Я╨╡╤А╤Ц╨╛╨┤╨╕</h4>
                            <button type="button" id="vacation-period-add" class="btn btn--secondary btn--small">
                                <i class="fas fa-plus"></i>
                                ╨Ф╨╛╨┤╨░╤В╨╕ ╨┐╨╡╤А╤Ц╨╛╨┤
                            </button>
                        </div>
                        <div id="vacation-periods-list" class="vacation-periods-list"></div>
                        <div id="vacation-periods-empty" class="vacation-periods-empty">╨Я╨╡╤А╤Ц╨╛╨┤╨╕ ╤Й╨╡ ╨╜╨╡ ╨┤╨╛╨┤╨░╨╜╨╛.</div>
                        <div class="vacation-periods-summary">
                            <span id="vacation-periods-total" class="vacation-periods-total">╨б╤Г╨╝╨░╤А╨╜╨╛: 0 ╨┤╨╜.</span>
                            <div class="vacation-limit-field">
                                <label for="vacation-limit-input" class="form-label vacation-limit-label">╨Ы╤Ц╨╝╤Ц╤В
                                    (╨┤╨╜╤Ц╨▓)</label>
                                <input type="number" id="vacation-limit-input" class="form-control vacation-limit-input"
                                    min="0" step="1" inputmode="numeric" pattern="[0-9]*">
                                <div id="vacation-limit-error" class="vacation-limit-error hidden"></div>
                                <div id="vacation-periods-limit" class="vacation-limit-helper"></div>
                            </div>
                        </div>
                    </div>
                    <div id="vacation-modal-error"
                        class="vacation-manager__message vacation-manager__message--error hidden"></div>
                    <div id="vacation-modal-warning"
                        class="vacation-manager__message vacation-manager__message--warning hidden"></div>
                    <div id="vacation-modal-success"
                        class="vacation-manager__message vacation-manager__message--success hidden"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="vacation-modal-cancel" class="btn btn--secondary">╨б╨║╨░╤Б╤Г╨▓╨░╤В╨╕</button>
                    <button type="submit" id="vacation-modal-save" class="btn btn--primary">
                        <i class="fas fa-save"></i>
                        ╨Ч╨▒╨╡╤А╨╡╨│╤В╨╕
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Employee Info Modal -->
    <div id="employee-info-modal" class="modal hidden" role="dialog" aria-modal="true"
        aria-labelledby="employee-info-title">
        <div class="modal-content employee-info-modal">
            <div class="modal-header">
                <h3 id="employee-info-title">╨Ж╨╜╤Д╨╛╤А╨╝╨░╤Ж╤Ц╤П ╨┐╤А╨╛ ╤Б╨┐╤Ц╨▓╤А╨╛╨▒╤Ц╤В╨╜╨╕╨║╨░</h3>
                <button type="button" id="employee-info-close" class="modal-close" aria-label="╨Ч╨░╨║╤А╨╕╤В╨╕">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="employee-info-section">
                    <h4 id="employee-info-name" class="employee-info-name">тАФ</h4>
                    <div class="employee-info-grid">
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Ж╨Я╨Э</span>
                            <span id="employee-info-tax-id" class="employee-info-value">тАФ</span>
                        </div>
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Я╤Ц╨┤╤А╨╛╨╖╨┤╤Ц╨╗</span>
                            <span id="employee-info-department" class="employee-info-value">тАФ</span>
                        </div>
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Я╨╛╤Б╨░╨┤╨░</span>
                            <span id="employee-info-position" class="employee-info-value">тАФ</span>
                        </div>
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Ь╨╡╨╜╨╡╨┤╨╢╨╡╤А</span>
                            <span id="employee-info-manager" class="employee-info-value">тАФ</span>
                        </div>
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Э╨░╤А╨░╤Е╨╛╨▓╨░╨╜╨╛, ╨┤╨╜.</span>
                            <span id="employee-info-accrued" class="employee-info-value">тАФ</span>
                        </div>
                        <div class="employee-info-field">
                            <span class="employee-info-label">╨Ч╨░╨╗╨╕╤И╨╛╨║, ╨┤╨╜.</span>
                            <span id="employee-info-balance" class="employee-info-value">тАФ</span>
                        </div>
                    </div>
                </div>
                <div class="employee-info-history">
                    <h4 class="employee-info-subtitle">╨Ж╤Б╤В╨╛╤А╤Ц╤П ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨╛╨║</h4>
                    <ul id="employee-info-history-list" class="info-history-list"></ul>
                    <div id="employee-info-history-empty" class="info-history-empty">╨Т╤Ц╨┤╨┐╤Г╤Б╤В╨╛╨║ ╤Й╨╡ ╨╜╨╡ ╨┤╨╛╨┤╨░╨╜╨╛.</div>
                </div>
            </div>
        </div>
    </div>
    <!-- BAS Export Modal -->
    <div id="bas-export-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="bas-export-title">
        <div class="modal-content bas-export-modal">
            <div class="modal-header">
                <h3 id="bas-export-title">╨Х╨║╤Б╨┐╨╛╤А╤В ╨▓ BAS</h3>
                <button type="button" id="bas-export-close" class="modal-close" aria-label="╨Ч╨░╨║╤А╨╕╤В╨╕">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="bas-export-form">
                <div class="modal-body">
                    <div id="bas-export-error" class="bas-export-error hidden" role="alert"></div>
                    <div class="bas-export-field-grid">
                        <div class="form-group">
                            <label for="bas-export-start" class="form-label">╨Ф╨░╤В╨░ ╨╖</label>
                            <input type="date" id="bas-export-start" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="bas-export-end" class="form-label">╨Ф╨░╤В╨░ ╨┐╨╛</label>
                            <input type="date" id="bas-export-end" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="bas-export-format" class="form-label">╨д╨╛╤А╨╝╨░╤В ╤Д╨░╨╣╨╗╤Г</label>
                        <select id="bas-export-format" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label for="bas-export-department" class="form-label">╨Я╤Ц╨┤╤А╨╛╨╖╨┤╤Ц╨╗</label>
                        <select id="bas-export-department" class="form-control">
                            <option value="">╨Т╤Б╤Ц ╨┐╤Ц╨┤╤А╨╛╨╖╨┤╤Ц╨╗╨╕</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <span class="form-label">╨б╤В╨░╤В╤Г╤Б╨╕ ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨╛╨║</span>
                        <div id="bas-export-statuses" class="bas-export-statuses"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="bas-export-cancel" class="btn btn--secondary">╨б╨║╨░╤Б╤Г╨▓╨░╤В╨╕</button>
                    <button type="submit" id="bas-export-submit" class="btn btn--primary">
                        <i class="fas fa-download" aria-hidden="true"></i>
                        <span class="bas-export-submit-label">╨Ч╨░╨▓╨░╨╜╤В╨░╨╢╨╕╤В╨╕</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
            <!-- Login Screen -->
            <div id="login-screen" class="welcome-screen">
                <div class="welcome-card">
                    <i class="fas fa-id-card welcome-icon"></i>
                    <h2>╨Т╤Е╤Ц╨┤ ╨┤╨╛ ╤Б╨╕╤Б╤В╨╡╨╝╨╕</h2>
                    <p>╨С╤Г╨┤╤М ╨╗╨░╤Б╨║╨░, ╨▓╨▓╨╡╨┤╤Ц╤В╤М ╨▓╨░╤И ╤Ц╨┤╨╡╨╜╤В╨╕╤Д╤Ц╨║╨░╤Ж╤Ц╨╣╨╜╨╕╨╣ ╨╜╨╛╨╝╨╡╤А (╨Ж╨Я╨Э), ╤Й╨╛╨▒ ╤Г╨▓╤Ц╨╣╤В╨╕.</p>
                    <form id="login-form" class="login-form">
                        <div class="form-group">
                            <label for="tax-id-input" class="form-label sr-only">╨Ж╨┤╨╡╨╜╤В╨╕╤Д╤Ц╨║╨░╤Ж╤Ц╨╣╨╜╨╕╨╣ ╨╜╨╛╨╝╨╡╤А (╨Ж╨Я╨Э)</label>
                            <input type="text" id="tax-id-input" class="form-control" placeholder="╨Т╨░╤И ╨Ж╨Я╨Э" required
                                autocomplete="off">
                        </div>
                        <button type="submit" id="login-btn" class="btn btn--primary btn--full-width">
                            <i class="fas fa-sign-in-alt"></i>
                            ╨г╨▓╤Ц╨╣╤В╨╕
                        </button>
                        <div id="login-error" class="form-error hidden"></div>
                    </form>
                </div>
            </div>

            <!-- Dashboard Container (initially hidden) -->
            <div id="dashboard-container" class="dashboard-container hidden">
                <!-- User Info Bar -->
                <div class="user-info-bar">
                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        <span id="current-user-name">╨Ъ╨╛╤А╨╕╤Б╤В╤Г╨▓╨░╤З</span>
                        <span id="current-user-role" class="user-role-badge">╨а╨╛╨╗╤М</span>
                    </div>
                    <div class="user-stats stats-grid" id="stats-grid">
                        <!-- Cards for stats will be rendered here -->
                    </div>
                </div>
                <!-- Tabs Navigation -->
                <nav id="tabs-nav" class="tabs-nav"></nav>
                <!-- Filters Section -->
                <section class="filters-section" id="filters-section">
                    <div class="filters-grid" id="filters-grid">
                        <!-- Filter controls will be rendered here -->
                    </div>
                </section>
                <!-- Content Area: Calendar + Table -->
                <div class="content-area">
                    <!-- Calendar Section -->
                    <section class="calendar-section" id="calendar-section">
                        <div class="calendar-header">
                            <h3>╨Ъ╨░╨╗╨╡╨╜╨┤╨░╤А ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨╛╨║</h3>
                            <div class="calendar-controls" id="calendar-controls"></div>
                        </div>
                        <div class="calendar-body">
                            <div id="vacation-calendar"></div>
                        </div>
                        <div class="calendar-legend" id="calendar-legend"></div>
                    </section>
                    <!-- Table Section -->
                    <section class="table-section" id="table-section">
                        <div class="table-header">
                            <h3 id="table-title">╨в╨░╨▒╨╗╨╕╤Ж╤П ╤Б╨┐╤Ц╨▓╤А╨╛╨▒╤Ц╤В╨╜╨╕╨║╤Ц╨▓</h3>
                            <div id="my-view-controls" class="table-header-controls hidden" aria-hidden="true">
                                <div class="my-view-filter-group">
                                    <label for="my-view-year-filter" class="filter-label">╨а╤Ц╨║</label>
                                    <select id="my-view-year-filter" class="filter-select">
                                        <option value="">╨Т╤Б╤Ц ╤А╨╛╨║╨╕</option>
                                    </select>
                                </div>
                                <div class="my-view-filter-group">
                                    <label for="my-view-status-filter" class="filter-label">╨б╤В╨░╤В╤Г╤Б</label>
                                    <select id="my-view-status-filter" class="filter-select">
                                        <option value="">╨Т╤Б╤Ц ╤Б╤В╨░╤В╤Г╤Б╨╕</option>
                                        <option value="╨Ч╨░╨┐╨╗╨░╨╜╨╛╨▓╨░╨╜╨╛">╨Ч╨░╨┐╨╗╨░╨╜╨╛╨▓╨░╨╜╨╛</option>
                                        <option value="╨Ь╨╕╨╜╤Г╨╗╤Ц ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨║╨╕">╨Ь╨╕╨╜╤Г╨╗╤Ц ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨║╨╕</option>
                                    </select>
                                </div>
                                <button id="my-view-reset-filters" class="btn btn--secondary btn--sm filter-reset-btn"
                                    type="button">
                                    <i class="fas fa-rotate-left"></i>
                                    <span>╨б╨║╨╕╨╜╤Г╤В╨╕ ╤Д╤Ц╨╗╤М╤В╤А╨╕</span>
                                </button>
                            </div>
                        </div>
                        <div class="table-container">
                            <table class="vacations-table" id="vacations-table">
                                <thead id="table-head">
                                    <tr class="table-head-template">
                                        <th>╨Ж╨╝'╤П</th>
                                        <th>╨Я╤Ц╨┤╤А╨╛╨╖╨┤╤Ц╨╗</th>
                                        <th>╨Я╨╛╤Б╨░╨┤╨░</th>
                                        <th>╨б╤В╨░╤В╤Г╤Б</th>
                                        <th>╨С╨╗╨╕╨╢╤З╨░ ╨▓╤Ц╨┤╨┐╤Г╤Б╤В╨║╨░</th>
                                        <th class="col-earned">╨Э╨░╤А╨░╤Е.</th>
                                        <th>╨Ч╨░╨╗╨╕╤И╨╛╨║ ╨┤╨╜╤Ц╨▓</th>
                                        <th>╨Ф╤Ц╤Ч</th>
                                    </tr>
                                </thead>
                                <tbody id="table-body"></tbody>
                            </table>
                        </div>
                        <div id="bas-actions" class="bas-actions hidden" aria-hidden="true">
                            <div class="bas-actions__header">
                                <p class="bas-actions__hint">╨б╨╕╨╜╤Е╤А╨╛╨╜╤Ц╨╖╨░╤Ж╤Ц╤П ╨╖ BAS Payroll/HR</p>
                            </div>
                            <div class="bas-actions__buttons">
                                <button type="button" id="bas-import-button"
                                    class="btn btn--secondary bas-actions__button bas-actions__button--import">
                                    <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
                                    <span>╨Ж╨╝╨┐╨╛╤А╤В ╨╖ BAS</span>
                                </button>
                                <button type="button" id="bas-export-button"
                                    class="btn btn--primary bas-actions__button bas-actions__button--export">
                                    <i class="fas fa-cloud-download-alt" aria-hidden="true"></i>
                                    <span>╨Х╨║╤Б╨┐╨╛╤А╤В ╨▓ BAS</span>
                                </button>
                            </div>
                            <input type="file" id="bas-import-file" class="bas-actions__file-input"
                                accept=".csv,.json,.xml" hidden>
                            <div id="bas-import-progress" class="bas-actions__progress hidden" aria-hidden="true">
                                <div class="bas-actions__progress-track">
                                    <div id="bas-import-progress-bar" class="bas-actions__progress-fill"
                                        role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                                    </div>
                                </div>
                                <span id="bas-import-progress-label" class="bas-actions__progress-label">╨У╨╛╤В╨╛╨▓╨╛ ╨┤╨╛
                                    ╤Ц╨╝╨┐╨╛╤А╤В╤Г</span>
                            </div>
                            <div id="bas-sync-log" class="bas-actions__log hidden" aria-live="polite"></div>
                        </div>
                    </section>
                </div>
                <!-- Tab Content (legacy, for compatibility) -->
                <div id="tab-content" class="tab-content"></div>
            </div>
        </div>
    </main>

    <!-- Firebase -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-functions-compat.js"></script>

    <!-- Firebase Configuration -->
    <script src="firebase-config.js"></script>
    <script src="bas-integration.js"></script>

    <!-- Legacy app.js (will be removed after migration) -->
    <script src="app.js"></script>

    <!-- New modular architecture (ES6 modules) -->
    <!-- Uncomment when ready to switch:
    <script type="module" src="js/main.js"></script>
    -->
</body>

</html>
